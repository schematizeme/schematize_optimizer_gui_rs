// Janela do schematize-optimizer. Casca visual fina: todos os dados vêm do binário
// `schematize-optimizer` (headless) e todas as ações disparam callbacks tratados no main.rs.
//
// O TEMA e o `Btn` são cópia da janela do market. Isso é PLATAFORMA (D4): não sabe o que é
// limite, slice ou GTT — sabe cor, borda e clique. Se um dia algo de domínio migrar para cá, o
// corte foi feito errado.

global Th {
    in-out property <bool> dark: true;
    out property <color> bg:          dark ? #14161c : #e8ecf4;
    out property <color> surface:     dark ? #1b1e27 : #ffffff;
    out property <color> surface-2:   dark ? #222634 : #dce3f0;
    out property <color> border:      dark ? #2b3040 : #bfc9dc;
    out property <color> text:        dark ? #e6e9f2 : #12151d;
    out property <color> text-dim:    dark ? #8a90a2 : #475062;
    out property <color> accent:      #5b8cff;
    out property <color> accent-soft: dark ? #2a3a66 : #cedcff;
    out property <color> good:        #3ecf8e;
    out property <color> warn:        #e6b23a;
    out property <color> header-fg:   dark ? #9db4ff : #2b48bd;
}

// (O `Chip` da janela do market não veio: aqui o par rótulo→valor é a `Ficha`, logo abaixo,
// que trata o valor VAZIO como travessão — porque nesta tela um campo pode legitimamente não
// ter número, e branco pareceria campo que não carregou.)

// Botão custom (mantém o tema; std-widgets traria estilo próprio).
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    border-radius: 10px;
    border-width: primary ? 0px : 1px;
    border-color: Th.border;
    background: !enabled ? Th.surface-2
        : primary ? (touch.has-hover ? #6f9bff : Th.accent)
        : (touch.has-hover ? Th.accent-soft : Th.surface);
    opacity: enabled ? 1.0 : 0.5;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: label;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: primary ? #ffffff : Th.text;
            font-size: 14px;
            font-weight: 600;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}


// Um par rótulo→valor, para as fichas do diagnóstico.
component Ficha inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Th.text;
    background: Th.surface-2;
    border-radius: 8px;
    border-width: 1px;
    border-color: Th.border;
    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text { text: label; color: Th.text-dim; font-size: 11px; }
        Text {
            // Vazio vira travessão: um espaço em branco parece campo que não carregou, e o
            // travessão diz "não sei" — que é a verdade quando a leitura não trouxe o número.
            text: value == "" ? "—" : value;
            color: value == "" ? Th.text-dim : value-color;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
    }
}

// Uma caixa (teto por software) na tela de limites. Espelha `telas::Caixa` do Rust.
export struct CaixaUI {
    nome: string,
    descricao: string,
    memoria-apertar: string,
    memoria-matar: string,
    cpu: string,
    io: string,
    aplicada: bool,
}

// Um serviço de boot na lista secundária. Espelha `telas::Servico`.
export struct ServicoUI {
    unidade: string,
    custo: string,
    auditado: bool,
    recomendado: bool,
    explicacao: string,
}

export component MainWindow inherits Window {
    title: "schematize · optimizer";
    preferred-width: 760px;
    preferred-height: 620px;
    min-width: 560px;
    min-height: 460px;
    background: Th.bg;

    in-out property <bool> dark <=> Th.dark;
    // 0 = Diagnóstico, 1 = Limites.
    in-out property <int> aba: 0;

    // ---- diagnóstico ----
    in-out property <string> versao: "—";
    in-out property <string> ram;
    in-out property <string> nucleos;
    in-out property <string> cgroups;
    in-out property <bool> cgroups-ok: false;
    in-out property <string> gpu;
    in-out property <string> vram;
    in-out property <string> gtt;
    in-out property <bool> limitavel: false;
    in-out property <string> parametro;
    in-out property <string> atual;
    in-out property <string> sugerido;
    in-out property <string> motivo;
    // Por que o diagnóstico não pôde ser lido. Vazio = deu certo.
    in-out property <string> erro;

    // ---- limites ----
    in-out property <[CaixaUI]> caixas;
    in-out property <string> diferenca;
    in-out property <bool> ha-mudanca: false;
    in-out property <string> limites-erro;
    in-out property <[ServicoUI]> servicos;
    // A lista de serviços começa FECHADA: ela é secundária, e uma tela que abre com trinta
    // linhas de coisa secundária esconde o que é primário.
    in-out property <bool> servicos-abertos: false;
    in-out property <string> msg;

    callback recarregar();
    callback aplicar();
    callback reverter();
    callback alternar-tema();
    callback alternar-servicos();

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // ---- Cabeçalho ----
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                Text {
                    text: "Otimizador";
                    color: Th.header-fg;
                    font-size: 20px;
                    font-weight: 800;
                }
                Text {
                    text: "schematize-optimizer " + root.versao;
                    color: Th.text-dim;
                    font-size: 12px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    label: "Diagnóstico";
                    primary: root.aba == 0;
                    clicked => { root.aba = 0; }
                }
                Btn {
                    label: "Limites";
                    primary: root.aba == 1;
                    clicked => { root.aba = 1; }
                }
                Btn {
                    label: root.dark ? "☾" : "☀";
                    clicked => { root.alternar-tema(); }
                }
            }
        }
        Rectangle { height: 1px; background: Th.border; }

        // ---- ERRO: é TELA, não ausência ----
        //
        // Sem isto, um optimizer ausente daria fichas vazias — que a pessoa leria como "esta
        // máquina não tem nada", em vez de "não consegui falar com o app". Foi essa confusão
        // entre "não sei" e "não tem" que quebrou a janela irmã.
        if root.erro != "": Rectangle {
            vertical-stretch: 1;
            background: Th.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Th.warn;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: center;
                Text {
                    text: "Não consegui ler o otimizador";
                    color: Th.warn;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.erro;
                    color: Th.text-dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: "Instale com:\n  cargo install --git https://github.com/schematizeme/schematize_optimizer_rs";
                    color: Th.text-dim;
                    font-size: 12px;
                    font-family: "monospace";
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // ---- ABA DIAGNÓSTICO ----
        if root.erro == "" && root.aba == 0: Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: diag.preferred-height;
            diag := VerticalLayout {
                width: parent.width;
                spacing: 12px;
                Text {
                    text: "A máquina";
                    font-size: 13px;
                    font-weight: 700;
                    color: Th.text-dim;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Ficha { label: "Memória"; value: root.ram; horizontal-stretch: 1; }
                    Ficha { label: "Núcleos"; value: root.nucleos; horizontal-stretch: 1; }
                    Ficha {
                        label: "cgroups v2";
                        value: root.cgroups;
                        // Sem cgroups v2 os tetos não funcionam — e dizer isso ANTES é melhor
                        // que escrever arquivos que o systemd vai ignorar em silêncio.
                        value-color: root.cgroups-ok ? Th.good : Th.warn;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: "A GPU";
                    font-size: 13px;
                    font-weight: 700;
                    color: Th.text-dim;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Ficha { label: "Fabricante"; value: root.gpu; horizontal-stretch: 1; }
                    Ficha { label: "VRAM própria"; value: root.vram; horizontal-stretch: 1; }
                    Ficha { label: "Memória do sistema mapeável (GTT)"; value: root.gtt; horizontal-stretch: 1; }
                }

                Rectangle {
                    background: Th.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.limitavel ? Th.border : Th.warn;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: root.limitavel
                                ? "Dá para limitar a memória que a GPU toma do sistema"
                                : "Nesta máquina NÃO dá para limitar isso";
                            font-size: 14px;
                            font-weight: 700;
                            color: root.limitavel ? Th.text : Th.warn;
                            wrap: word-wrap;
                        }
                        // O caminho POSSÍVEL: os números e o parâmetro de kernel.
                        if root.limitavel: HorizontalLayout {
                            spacing: 10px;
                            Ficha { label: "Hoje"; value: root.atual; horizontal-stretch: 1; }
                            Ficha {
                                label: "Sugerido";
                                value: root.sugerido;
                                value-color: Th.accent;
                                horizontal-stretch: 1;
                            }
                            Ficha { label: "Parâmetro do kernel"; value: root.parametro; horizontal-stretch: 1; }
                        }
                        // Isto NÃO tem botão, e a ausência é a honestidade: mudar parâmetro de
                        // kernel exige editar o cmdline e reiniciar. Um botão aqui prometeria
                        // um clique onde há um reboot.
                        if root.limitavel: Text {
                            text: "Isto não se aplica por um clique: é parâmetro de kernel, vai no cmdline do boot e vale no próximo reinício. A janela mostra o número; quem edita o boot é você.";
                            font-size: 12px;
                            color: Th.text-dim;
                            wrap: word-wrap;
                        }
                        // O caminho IMPOSSÍVEL: por quê. Prometer o mesmo em toda máquina
                        // seria mentir em duas de cada três.
                        if !root.limitavel: Text {
                            text: root.motivo;
                            font-size: 12.5px;
                            color: Th.text-dim;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Btn { label: "Recarregar"; clicked => { root.recarregar(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // ---- ABA LIMITES ----
        if root.erro == "" && root.aba == 1: Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: lim.preferred-height;
            lim := VerticalLayout {
                width: parent.width;
                spacing: 12px;

                // O QUE MUDA, antes de mudar. É onde esta janela ganha da CLI: no terminal, o
                // `limits` mostra o que sugeriria e o `--apply` escreve, e entre os dois não há
                // nada que diga a diferença.
                Rectangle {
                    background: Th.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.ha-mudanca ? Th.accent : Th.border;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: "O que muda na sua máquina";
                            font-size: 14px;
                            font-weight: 700;
                            color: Th.text;
                        }
                        Text {
                            text: root.diferenca;
                            font-size: 12.5px;
                            color: root.ha-mudanca ? Th.text : Th.text-dim;
                            wrap: word-wrap;
                        }
                        if root.limites-erro != "": Text {
                            text: root.limites-erro;
                            font-size: 12px;
                            color: Th.warn;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Btn {
                                label: "Aplicar";
                                primary: true;
                                // Desabilitado quando não há o que aplicar: um botão aceso ali
                                // convidaria a reescrever o que já está certo.
                                enabled: root.ha-mudanca;
                                clicked => { root.aplicar(); }
                            }
                            Btn { label: "Reverter"; clicked => { root.reverter(); } }
                            Btn { label: "Recarregar"; clicked => { root.recarregar(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: "Aplicar e reverter abrem um TERMINAL: mexer em systemd pode pedir a sua senha, e a senha precisa de onde ser digitada.";
                            font-size: 11.5px;
                            color: Th.text-dim;
                            wrap: word-wrap;
                        }
                    }
                }

                for c in root.caixas: Rectangle {
                    border-radius: 12px;
                    background: Th.surface;
                    border-width: 1px;
                    border-color: Th.border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: c.nome;
                                font-size: 14px;
                                font-weight: 700;
                                color: Th.text;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 22px;
                                width: est.preferred-width + 20px;
                                border-radius: 11px;
                                property <color> tom: c.aplicada ? Th.good : Th.accent;
                                background: tom.transparentize(0.85);
                                border-width: 1px;
                                border-color: tom.transparentize(0.5);
                                est := Text {
                                    text: c.aplicada ? "aplicado" : "vai ser criado";
                                    color: c.aplicada ? Th.good : Th.accent;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: c.descricao;
                            font-size: 12.5px;
                            color: Th.text-dim;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            // `MemoryHigh` é onde o kernel APERTA; `MemoryMax` é onde ele MATA.
                            // Os rótulos dizem isso em palavras, e não em nome de diretiva: a
                            // distância entre os dois é o que troca "o build morreu depois de
                            // uma hora" por "o build demorou mais".
                            Ficha { label: "Começa a apertar em"; value: c.memoria-apertar; horizontal-stretch: 1; }
                            Ficha { label: "Mata em"; value: c.memoria-matar; horizontal-stretch: 1; }
                            Ficha { label: "CPU"; value: c.cpu; horizontal-stretch: 1; }
                            Ficha { label: "Prioridade de disco"; value: c.io; horizontal-stretch: 1; }
                        }
                    }
                }

                // ---- Serviços de boot: lista SECUNDÁRIA, fechada por padrão ----
                Rectangle {
                    background: Th.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Th.border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "O que sobe no boot (" + root.servicos.length + ")";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Th.text;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Btn {
                                label: root.servicos-abertos ? "Esconder" : "Mostrar";
                                clicked => { root.alternar-servicos(); }
                            }
                        }
                        if !root.servicos-abertos: Text {
                            text: "Esta lista só RELATA. Desabilitar serviço é onde se quebra máquina, e a causa fica longe do sintoma — então aqui não há botão, só o comando para você decidir item a item.";
                            font-size: 12px;
                            color: Th.text-dim;
                            wrap: word-wrap;
                        }
                        if root.servicos-abertos: VerticalLayout {
                            spacing: 8px;
                            for s in root.servicos: VerticalLayout {
                                spacing: 3px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: s.custo;
                                        font-size: 12px;
                                        font-family: "monospace";
                                        color: Th.text-dim;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: s.unidade;
                                        font-size: 12.5px;
                                        color: Th.text;
                                        vertical-alignment: center;
                                    }
                                    // Duas marcas, porque são duas afirmações: "auditado" é
                                    // propriedade do serviço; "vale a pena" é medição DESTA
                                    // máquina. Um serviço seguro que não custa nada aqui
                                    // continua seguro — só não vale o trabalho.
                                    if s.auditado: Text {
                                        text: s.recomendado ? "· seguro e vale a pena" : "· seguro, mas não custa nada aqui";
                                        font-size: 11.5px;
                                        color: s.recomendado ? Th.good : Th.text-dim;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if s.explicacao != "": Text {
                                    text: s.explicacao;
                                    font-size: 11.5px;
                                    color: Th.text-dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.msg != "": Text {
            text: root.msg;
            font-size: 12px;
            color: Th.text-dim;
            wrap: word-wrap;
        }
    }
}
